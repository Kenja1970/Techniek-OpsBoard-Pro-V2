# Techniek OpsBoard Pro V2 — optional local proxy configuration
#
# Copy this file to server/.env.local and fill in your own values.
# server/.env.local is gitignored and MUST stay out of revision control.
# The browser never receives these values — the proxy holds them server-side.
#
# NOTHING in the default product path requires this file. The PM Advisor, the
# PM Agent's command mode, and the local knowledge base all run offline with no
# key. This file only enables two optional extras:
#   1. LLM intent + narrative for the PM Agent  (LLM_* below)
#   2. The legacy external vector-store Q&A path (OPENAI_* below)

# ---------------------------------------------------------------------------
# 1. Agent LLM (optional) — any OpenAI-compatible /chat/completions endpoint
# ---------------------------------------------------------------------------
# Default gateway is OpenRouter. Alternatives:
#   OpenAI  ->  LLM_BASE_URL=https://api.openai.com/v1
#   Ollama  ->  LLM_BASE_URL=http://localhost:11434/v1   (LLM_API_KEY=ollama)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Model id as your gateway names it. On OpenRouter these are "vendor/model".
# Check your provider's current model list rather than copying a value from
# documentation — model ids change and stale ones fail with a 404.
LLM_MODEL=
LLM_MAX_TOKENS=1500

# ---------------------------------------------------------------------------
# 2. Legacy vector-store Q&A (optional, OpenAI-specific)
# ---------------------------------------------------------------------------
# Only needed if you escalate procedure questions to a hosted OpenAI vector
# store. The built-in local knowledge base covers this without a key.
OPENAI_API_KEY=
OPENAI_VECTOR_STORE_ID=
OPENAI_PM_MODEL=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PM_PROXY_PORT=8787
# Comma-separated CORS allowlist. Localhost only — this proxy holds an API key
# and must never be reachable from a public origin.
ALLOWED_ORIGINS=http://localhost:8100,http://127.0.0.1:8100
